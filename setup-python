#!/usr/bin/env bash
set -euo pipefail

# Creates/uses a project-local virtual environment. Arch and other PEP 668
# distributions refuse `pip install` into the system interpreter, and the
# system python3 here has no pip module at all, so a venv is the supported path.

VENV="${KIWI_VENV:-.venv-kiwi}"
cd "$(dirname "$0")"

if [ ! -x "$VENV/bin/python" ]; then
    echo "Creating virtual environment: $VENV"
    python3 -m venv "$VENV"
fi

"$VENV/bin/python" -m pip install --upgrade pip
"$VENV/bin/python" -m pip install -e '.[dev,live,playback,image]'
"$VENV/bin/python" - <<'PY'
import importlib.util
import sys

required = {
    "pytest": "dev test runner",
    "websockets": "live KiwiSDR capture/playback",
    "sounddevice": "live audio playback",
    "matplotlib": "waterfall PNG tool",
}
missing = [f"{name} ({purpose})" for name, purpose in required.items() if importlib.util.find_spec(name) is None]
if missing:
    print("setup-python did not make all required project libraries importable:", file=sys.stderr)
    for item in missing:
        print(f"  - {item}", file=sys.stderr)
    print("Try: .venv-kiwi/bin/python -m pip install -e '.[dev,live,playback,image]'", file=sys.stderr)
    raise SystemExit(1)
print("Kiwi client Python dependencies are installed.")
PY

echo
echo "Activate with:   source $VENV/bin/activate"
echo "Or run directly: $VENV/bin/python -m pytest"
