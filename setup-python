#!/usr/bin/env bash
set -euo pipefail

venv_dir="${KIWI_CLIENT_VENV:-.kiwi-venv}"

if [[ ! -x "$venv_dir/bin/python" ]]; then
    python3 -m venv "$venv_dir"
fi

"$venv_dir/bin/python" -m pip install -e '.[dev,live,playback,image]'
"$venv_dir/bin/python" - <<'PY'
import importlib.util
import sys

required = {
    "pytest": "dev test runner",
    "websockets": "live KiwiSDR capture/playback",
    "sounddevice": "live audio playback",
    "matplotlib": "waterfall PNG tool",
}
missing = [f"{name} ({purpose})" for name, purpose in required.items() if importlib.util.find_spec(name) is None]
if missing:
    print("setup-python did not make all required project libraries importable:", file=sys.stderr)
    for item in missing:
        print(f"  - {item}", file=sys.stderr)
    raise SystemExit(1)
print("Kiwi client Python dependencies are installed in the project virtual environment.")
PY

printf 'Activate it with: source %q/bin/activate\n' "$venv_dir"
printf 'Or run tests directly: %q/bin/python -m pytest\n' "$venv_dir"
